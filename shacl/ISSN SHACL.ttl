issnshapes:P29 a skos:Concept;
  sh:path issnprop:hasCancelledISSN-L;
  sh:name "has cancelled ISSN-L"@en;
  sh:description "This property indicates the value of a former ISSN-L of the resource, which has been cancelled. This generally happens when it is recognized that a link between two different medium versions of the same resource has not been recorded in the original record."@en;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dct:source "023$z first indicator 0";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P30 a skos:Concept;
  sh:path issnprop:hasCancelledISSN-H;
  sh:name "has cancelled ISSN-H"@en;
  sh:description "This property indicates the value of a former ISSN-H of the resource, but this link has been cancelled. This happens for instance when two ISSN-H clusters merged together which means that one ISSN-H becomes obsolete."@en;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dct:source "023$z first indicator 1";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P31 a skos:Concept;
  sh:path issnprop:hasIncorrectISSN;
  sh:name "has incorrect ISSN"@en;
  sh:description "This property indicates the value of an incorrect ISSN wrongly displayed on the resource. The incorrect ISSN may be structurally invalid (e.g. wrong control number) or it may be a valid ISSN assigned to another resource."@en;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dct:source "'022$y";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

