issnshapes:ISSNResource-target sh:select """# An ISSN is defined as a resource identified by an
# identifier of type bf:Issn
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
SELECT ?this
WHERE {
 ?this bf:identifiedBy ?identifier .
 ?identifier a bf:Issn .
}""" .

issnshapes:ISSN-L a sh:NodeShape;
  rdfs:label "ISSN-L"@en;
  sh:target issnshapes:ISSN-L-target;
  sh:nodeKind sh:IRI;
  sh:order "15"^^xsd:integer;
  sh:pattern "^http://issn.org/resource/ISSN-L/[0-9][0-9][0-9][0-9][-][0-9][0-9][0-9][X0-9]$";
  sh:property issnshapes:P93, issnshapes:P94, issnshapes:P95 .

issnshapes:ISSN-L-target sh:select """# an ISSN-L is defined as any resource with a URI starting with \".../ISSN-L\"
SELECT ?this
WHERE {
 ?this ?p ?o .
 FILTER(STRSTARTS(STR(?this), \"http://issn.org/resource/ISSN-L/\"))
}""" .

