issnshapes:P42 a skos:Concept;
  sh:path schema:alternateName;
  sh:name "alternate name"@en;
  sh:description "This property contains an alternate title for the continuing resource i.e. any title other than the key title and title proper."@en;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dct:source "'210$a+210$b, 222$a+222$b, 246a, 246$1, 246$2, 246$3, 246$4, 246$5, 246$6, 246$7, 246$8";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P43 a skos:Concept;
  sh:path schema:contributor;
  sh:name "contributor"@en;
  sh:description "This property relates the resource to the organization in charge of editing its intellectual content (generally a university, a specific department within an international organization…). In very rare cases, it may be an individual person. In the ISSN data model, this property is similar to bfrel:isb but has been kept in parallel as it is a schema.org property."@en;
  sh:nodeKind sh:IRI;
  sh:node issnshapes:ISSNOrganization;
  dct:source "'710$a, 710$b, 711$a";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P44 a skos:Concept;
  sh:path schema:endDate;
  sh:name "end date"@en;
  sh:description "This property contains the end date of the ISSN. The value \"u\" indicates that the date or a part of a date is unknown. Hence the datatype is kept as xsd:string. Value 9999 means that the resource is still running."@en;
  sh:minCount "1"^^xsd:integer;
  sh:maxCount "1"^^xsd:integer;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dct:source "'008/11-14";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P45 a skos:Concept;
  sh:path schema:inLanguage;
  sh:name "in language"@en;
  sh:description "This property refers to the language of the continuing resource."@en;
  sh:minCount "1"^^xsd:integer;
  sh:node issnshapes:InLanguage;
  sh:group issnshapes:controlledVocs;
  dct:source "'008/35-37, 041$a";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

issnshapes:P46 a skos:Concept;
  sh:path schema:isPartOf;
  sh:name "is part of"@en;
  sh:description "This property refers to the ISSN-L or to the ISSN-H of which this ISSN is part of. There is always one ISSN-L, but not always an ISSN-H for each ISSN."@en;
  sh:minCount "1"^^xsd:integer;
  sh:maxCount "2"^^xsd:integer;
  sh:nodeKind sh:IRI;
  sh:or _:ae587f1f220542eb847087bc3e2b8637109;
  dct:source "023$a first indicator 0 for ISSN-L or 1 for ISSN-H";
  skos:inScheme <http://issn.org/vocabularies/shapes>;
  skos:topConceptOf <http://issn.org/vocabularies/shapes> .

